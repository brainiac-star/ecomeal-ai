# Anthropic API
# ── LLM Provider (pick ONE — all have free tiers) ─────────────────────────────
# Option 1: Groq (RECOMMENDED — fastest free option)
# Sign up free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini Flash (free tier)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option 3: Anthropic Claude (paid)
ANTHROPIC_API_KEY=

# Option 4: Ollama (local, no key needed)
# Install from https://ollama.ai then run: ollama pull llama3
# No key needed — just have Ollama running locally

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Streamlit Settings
STREAMLIT_PORT=8501

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Model Settings
MODEL_DIR=./models
DATA_DIR=./data/raw
RANDOM_SEED=42

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
